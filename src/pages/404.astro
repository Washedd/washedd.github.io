    <h1>Page not found</h1>
    <p>Nothing is mounted at this path.</p>
    <p>
      <a href="/">Home</a> ·
      <a href="/about">About</a> ·
      <a href="/projects">Projects</a> ·
      <a href="/contact">Contact</a>
    </p>
  </Window>
</Desktop>
