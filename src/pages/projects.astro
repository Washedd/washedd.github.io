---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import Window from '../components/Window.astro';
import Desktop from '../layouts/Desktop.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Desktop
  active="projects"
  title="Projects · Ethan Byrne"
  description="Projects by Ethan Byrne — rustplusplus, Jeva, and more."
>
  <Window id="window-projects" title="~/projects" open overlay closeHref="/">
    <h1>Projects</h1>
    <p>Same files as <code>ls ~/projects</code> in the terminal.</p>
    <div class="project-list">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Window>
</Desktop>
