---
import { getCollection } from 'astro:content';
import ProjectArchiveRow from '../components/ProjectArchiveRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Window from '../components/Window.astro';
import Desktop from '../layouts/Desktop.astro';

const all = await getCollection('projects');
const featured = all
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const archive = all
  .filter((project) => !project.data.featured)
  .sort((a, b) => {
    const byCategory = a.data.category.localeCompare(b.data.category);
    if (byCategory !== 0) {
      return byCategory;
    }
    return a.data.title.localeCompare(b.data.title);
  });
---

<Desktop
  active="projects"
  title="Projects · Ethan Byrne"
  description="Selected work by Ethan Byrne — Discord bots, FiveM tooling, trading utilities, and the web."
>
  <Window id="window-projects" title="~/projects" open overlay closeHref="/">
    <h1>Projects</h1>
    <p>Selected work across Discord, FiveM, and the web. Private projects are named without source links.</p>
    <div class="project-list">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
    {archive.length > 0 ? (
      <details class="archive">
        <summary>More projects ({archive.length})</summary>
        <ul class="archive-list">
          {archive.map((project) => <ProjectArchiveRow project={project} />)}
        </ul>
      </details>
    ) : null}
  </Window>
</Desktop>
