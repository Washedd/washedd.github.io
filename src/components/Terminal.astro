---
interface Props {
  user: string;
  host: string;
  cwd: string;
}

const { user, host, cwd } = Astro.props;
---

<div class="terminal" id="terminal">
  <div class="term-output" id="term-output" aria-live="polite"></div>
  <form class="prompt-line" id="term-form" autocomplete="off">
    <label>
      <span class="prompt-text" id="term-prompt">{user}@{host}:{cwd}$</span>
      <input
        id="term-input"
        name="command"
        type="text"
        spellcheck="false"
        autocapitalize="off"
        autocorrect="off"
        aria-label="Command"
      />
    </label>
  </form>
</div>
