---
import type { ActiveWindow } from '../lib/types';

interface Props {
  active: ActiveWindow;
  github: string;
}

const { active, github } = Astro.props;
---

<nav class="dock" aria-label="ethanOS dock">
  <a href="/" title="Terminal" aria-label="Terminal" aria-current={active === 'home' ? 'page' : undefined}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2"></rect>
      <path d="M7 9l3 3-3 3"></path>
      <path d="M12 15h5"></path>
    </svg>
  </a>
  <a href="/about" title="About" aria-label="About" aria-current={active === 'about' ? 'page' : undefined}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="12" cy="8" r="3.2"></circle>
      <path d="M5.5 19c1.4-3.2 3.7-4.7 6.5-4.7S16.6 15.8 18 19"></path>
    </svg>
  </a>
  <a href="/projects" title="Projects" aria-label="Projects" aria-current={active === 'projects' ? 'page' : undefined}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M3 7.5h7l2 2.5h9v9.5H3V7.5z"></path>
    </svg>
  </a>
  <a href="/contact" title="Contact" aria-label="Contact" aria-current={active === 'contact' ? 'page' : undefined}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect>
      <path d="M4 7l8 6 8-6"></path>
    </svg>
  </a>
  <a href={github} title="GitHub" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 10.0.5.092.682-.217.682-.482 0-.237-.009-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0 1 12 6.844a9.54 9.54 0 0 1 2.504.337c1.909-1.294 2.748-1.025 2.748-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48A10.019 10.019 0 0 0 22 12c0-5.523-4.477-10-10-10z"></path>
    </svg>
  </a>
</nav>
